# Copy to .env and edit. .env is gitignored; this file is the committed template.
#   cp .env.example .env

# --- Database ----------------------------------------------------------------
# Matches the credentials in docker-compose.yml. The "+psycopg" suffix selects
# the psycopg 3 driver rather than the legacy psycopg2 one.
DATABASE_URL=postgresql+psycopg://miniledger:miniledger@localhost:5432/miniledger

# Separate database so the test suite never touches development data.
TEST_DATABASE_URL=postgresql+psycopg://miniledger:miniledger@localhost:5432/miniledger_test

# --- Stripe (Phase 4) --------------------------------------------------------
# TEST MODE ONLY. Keys must start with sk_test_ — the app refuses to boot with a
# live key, so a copy-paste accident cannot move real money.
STRIPE_API_KEY=sk_test_replace_me

# Printed by `stripe listen --forward-to localhost:8000/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
